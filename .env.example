# 이 파일을 프로젝트 루트의 .env로 복사합니다. 실제 값은 .env에서만 관리합니다.
# .env는 Git 제외 대상입니다. 셸에서 지정한 환경변수가 우선합니다.

# 카카오: 같은 앱의 JavaScript 키(지도)와 REST API 키(이동시간)
KAKAO_MAPS_JAVASCRIPT_KEY=
KAKAO_MOBILITY_REST_API_KEY=
# 휴대폰에 다른 JavaScript 키를 쓸 때만 입력, 비어 있으면 위 키를 공용 사용
DEMO_MOBILE_KAKAO_MAPS_JAVASCRIPT_KEY=

# 회사 공개 연결 정보: service_role/secret 키를 넣지 않습니다.
DEMO_SUPABASE_URL=
DEMO_SUPABASE_KEY=
DEMO_WORKSPACE_ID=

# Android release: 키 파일은 프로젝트 밖의 기존 위치를 유지합니다.
DEMO_ANDROID_KEYSTORE=
DEMO_ANDROID_STORE_PASSWORD=
DEMO_ANDROID_KEY_ALIAS=
DEMO_ANDROID_KEY_PASSWORD=
DEMO_ANDROID_CERTIFICATE_SHA256=
# 필요한 경우 Android SDK 경로를 지정합니다.
# ANDROID_HOME=
# JAVA_HOME=

# 시작 묘지를 고르는 Google 지도 (기존 키와 지도 ID 사용)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_ID=

# 서버 전용 R2/관리자 키는 Supabase 함수의 서버 환경변수에서 관리합니다.
# 직원 로그인 암호·로그인 세션·일회용 이전 토큰은 이 파일에 보관하지 않습니다.
