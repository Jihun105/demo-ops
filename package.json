{
  "name": "demo-desktop",
  "version": "0.2.9",
  "private": true,
  "description": "(주)데모 고객 관리 데스크톱 프로그램",
  "author": "(주)데모",
  "main": "src/desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:live": "node scripts/dev-live/start.cjs",
    "dev:live:stop": "node scripts/dev-live/start.cjs stop",
    "desktop:config": "node scripts/windows/build-desktop-config.cjs",
    "desktop:prepare": "node scripts/windows/build-windows-desktop.cjs --prepare",
    "desktop:build:win": "node scripts/windows/build-windows-desktop.cjs",
    "test": "node --test --test-concurrency=4 \"tests/!(integration)/**/*.test.cjs\"",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.cjs",
    "mobile:build": "node scripts/build-mobile.cjs",
    "mobile:preview": "node scripts/preview-mobile.cjs",
    "pretest": "node scripts/build-mobile.cjs --test",
    "predev": "npm run mobile:build",
    "prestart": "npm run mobile:build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local:start": "node scripts/local-test/cli.cjs start",
    "local:status": "node scripts/local-test/cli.cjs status",
    "local:stop": "node scripts/local-test/cli.cjs stop",
    "local:reset": "node scripts/local-test/cli.cjs reset",
    "local:seed": "node scripts/local-test/cli.cjs seed",
    "local:test": "node scripts/local-test/cli.cjs test",
    "cloud:build": "node scripts/build-cloud-sql.cjs",
    "workflow:test": "node scripts/workflow-test/start.cjs",
    "workflow:verify": "node scripts/workflow-test/verify.cjs",
    "staging:setup": "node scripts/staging/setup.cjs",
    "staging:reset": "node scripts/staging/reset.cjs",
    "staging:app": "node scripts/staging/start.cjs",
    "staging:phone": "node scripts/staging/phone.cjs",
    "staging:remove": "node scripts/staging/remove.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electron/asar": "3.4.1",
    "7zip-bin": "5.2.0",
    "electron": "44.4.3",
    "electron-builder": "26.17.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.0",
    "prettier": "3.9.9",
    "prettier-plugin-java": "2.11.0",
    "supabase": "2.120.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "exceljs": "^4.4.0",
    "jszip": "3.10.2",
    "saxes": "6.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
